required_files <- c(
".shp",
".shx",
".dbf"
)
missing_files <- c()
for (extension in required_files) {
test_file <- sub(
"\\.shp$",
extension,
gambia_shp
)
if (!file.exists(test_file)) {
missing_files <- c(
missing_files,
basename(test_file)
)
}
}
